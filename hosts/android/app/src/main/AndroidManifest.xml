<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- One APK for TV and tablet: neither Leanback nor a touchscreen is required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- usesCleartextTraffic: the spike plays synthetic HLS from a local server (10.0.2.2). -->
    <application
        android:label="Patina"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <!-- simpleperf from adb on a release (non-debuggable) build. -->
        <profileable android:shell="true" />

        <provider
            android:name="com.longbridge.nsh.FilesProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Picture in picture: the activity is resized, never recreated
             (configChanges); singleTask, so the launcher's icon brings the
             one in the window back instead of starting a second one in it. -->
        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
