FROM archlinux:base
RUN pacman -Syu --noconfirm python xorg-xwininfo xorg-server-xvfb xorg-xauth dbus procps-ng
COPY smoke-desktop.py /smoke-desktop.py
ENTRYPOINT ["bash", "-ec", "pacman -U --noconfirm /packages/*.pkg.tar.zst; test -s /opt/patina/notices/THIRD-PARTY.html; test -s /opt/patina/notices/runner-components.json; timeout 90 xvfb-run -a dbus-run-session -- python3 /smoke-desktop.py /usr/bin/patina"]
